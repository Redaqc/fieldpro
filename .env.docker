# FieldPro FSM - Docker Environment Configuration
# Copy this file to .env and update with your values
# Used by docker-compose.yml

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_NAME=fieldpro
DB_USER=fieldpro
DB_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION
DB_PORT=5432

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Frontend URL (used for CORS)
FRONTEND_URL=http://localhost

# Backend port (external)
BACKEND_PORT=3001

# Frontend port (external)
FRONTEND_PORT=80

# ============================================
# JWT AUTHENTICATION
# ============================================
# IMPORTANT: Generate a strong secret for production
# You can use: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_USE_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
# For sending notifications and alerts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=FieldPro FSM <noreply@yourcompany.com>

# ============================================
# SMS CONFIGURATION (Optional)
# ============================================
# For sending SMS notifications
SMS_API_KEY=your-sms-api-key

# ============================================
# STORAGE CONFIGURATION
# ============================================
STORAGE_TYPE=local
# For S3: set STORAGE_TYPE=s3 and configure AWS credentials

# ============================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ============================================

# QuickBooks
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=

# Zoho Books
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=

# ============================================
# FRONTEND API URL
# ============================================
# URL where frontend can reach the backend API
# For development: http://localhost:3001/api
# For production with nginx proxy: /api (relative)
VITE_API_URL=/api
